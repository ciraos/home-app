#! .env.example
# 复制为 .env 后按需修改。.env 不会进 git。

# ---------- 数据库 ----------
# 只用一个连接串，不拆 host / port / user / password。
# 需要 SSL 就把参数写在 URL 里，例如 ...?sslmode=require
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/home_app
#
# 本地没有 Postgres 时可以改用 PGlite（WASM 版 PostgreSQL），数据落在 ./data/pg：
# DATABASE_URL=pglite://./data/pg

# ---------- 鉴权 ----------
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 修改它会让所有已登录会话立即失效（用于紧急踢人）。
AUTH_SECRET=replace-with-a-long-random-string

# 生产环境走 HTTPS 时保持 true；用 http 访问本地生产构建时设为 false
COOKIE_SECURE=true

# ---------- 首页外部接口（可选） ----------
# 文章列表接口（供「最近文章」区块使用）
# NEXT_PUBLIC_ARTICLES_API_URL=https://blog.ciraos.top/api/public/articles
